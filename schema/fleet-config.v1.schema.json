{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grok-bot.local/schemas/fleet-config.v1.schema.json",
  "title": "fleet-config.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "exportedAt", "source", "plugins", "rules", "skills", "fleetDocs", "agents", "rooms", "bootstrap"],
  "properties": {
    "schema": { "const": "fleet-config.v1" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "description": "Scrubbed source label; no account ids" }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pluginId"],
        "properties": {
          "pluginId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.mdc$" },
          "content": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "description", "body"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "fleetDocs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleKey", "name", "description", "routines"],
        "properties": {
          "roleKey": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "routines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "name", "description", "scheduleOrTriggerIntent", "prompt"],
              "properties": {
                "slug": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "scheduleOrTriggerIntent": { "type": "string" },
                "prompt": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "charter", "memberRoleKeys"],
        "properties": {
          "name": { "type": "string" },
          "charter": { "type": "string" },
          "memberRoleKeys": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 6
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "notes"],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["plugins", "rules", "skills", "agents", "rooms", "healthchecks"]
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
